#!/bin/bash

# Reads and writes the kernel's battery charge controls for the Bettery plugin.
#
#   bettery-hw status                    key<TAB>value lines describing the battery
#   bettery-hw set-thresholds START END  START may be "-" on batteries without one
#   bettery-hw set-behaviour MODE        auto | inhibit-charge | force-discharge
#   bettery-hw apply START END MODE      both of the above, then status; "-" skips;
#                                        always exits 0 and reports errors in-band
#
# Exit codes: 0 ok, 1 write failed, 2 usage, 3 no battery with charge control,
# 4 no write access (run install.sh once).

set -u

power_supply_path="${BETTERY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

fail() {
  local code=$1
  shift
  echo "bettery-hw: $*" >&2
  exit "$code"
}

read_value() {
  local value
  { value=$(<"$1"); } 2>/dev/null || return 1
  printf '%s' "$value"
}

# The first battery that powers the system and has a charge limit. Peripheral
# batteries (mice, headsets) report scope "Device".
find_battery() {
  local supply
  for supply in "$power_supply_path"/*; do
    [[ $(read_value "$supply/type") == "Battery" ]] || continue
    [[ $(read_value "$supply/scope") == "Device" ]] && continue
    [[ -e $supply/charge_control_end_threshold ]] || continue
    printf '%s' "$supply"
    return 0
  done
  return 1
}

# "auto [inhibit-charge] force-discharge" -> "inhibit-charge"
current_behaviour() {
  local raw
  raw=$(read_value "$1/charge_behaviour") || return 1
  [[ $raw =~ \[([a-z-]+)\] ]] && printf '%s' "${BASH_REMATCH[1]}"
}

is_percent() {
  [[ $1 =~ ^[0-9]{1,3}$ ]] && (( 10#$1 <= 100 ))
}

write_value() {
  local file=$1 value=$2
  [[ $(read_value "$file") == "$value" ]] && return 0
  [[ -w $file ]] || fail 4 "no write access to $file (run install.sh once)"
  printf '%s' "$value" 2>/dev/null >"$file" || fail 1 "the kernel refused $value for $file"
}

cmd_status() {
  local battery
  battery=$(find_battery) || { printf 'supported\t0\n'; return 0; }

  local start="" end behaviour="" behaviours="" writable=1
  end=$(read_value "$battery/charge_control_end_threshold")
  [[ -e $battery/charge_control_start_threshold ]] && start=$(read_value "$battery/charge_control_start_threshold")
  if [[ -e $battery/charge_behaviour ]]; then
    behaviour=$(current_behaviour "$battery")
    behaviours=$(read_value "$battery/charge_behaviour" | tr -d '[]')
  fi

  local file
  for file in charge_control_end_threshold charge_control_start_threshold charge_behaviour; do
    [[ -e $battery/$file && ! -w $battery/$file ]] && writable=0
  done

  # Health: the capacity the battery holds today against what it was built for.
  local full design health=""
  full=$(read_value "$battery/energy_full" || read_value "$battery/charge_full")
  design=$(read_value "$battery/energy_full_design" || read_value "$battery/charge_full_design")
  if [[ $full =~ ^[0-9]+$ && $design =~ ^[0-9]+$ ]] && (( design > 0 )); then
    health=$(( (full * 100 + design / 2) / design ))
  fi

  printf 'supported\t1\n'
  printf 'battery\t%s\n' "${battery##*/}"
  printf 'writable\t%s\n' "$writable"
  printf 'end\t%s\n' "$end"
  [[ -n $start ]] && printf 'start\t%s\n' "$start"
  [[ -n $behaviours ]] && printf 'behaviours\t%s\n' "$behaviours"
  [[ -n $behaviour ]] && printf 'behaviour\t%s\n' "$behaviour"
  [[ -n $health ]] && printf 'health\t%s\n' "$health"
  printf 'capacity\t%s\n' "$(read_value "$battery/capacity")"
  printf 'status\t%s\n' "$(read_value "$battery/status")"
  return 0
}

cmd_set_thresholds() {
  (( $# == 2 )) || fail 2 "usage: bettery-hw set-thresholds START|- END"
  local start=$1 end=$2
  is_percent "$end" || fail 2 "invalid end threshold: $end"
  [[ $start == "-" ]] || is_percent "$start" || fail 2 "invalid start threshold: $start"
  [[ $start == "-" ]] || (( 10#$start < 10#$end )) || fail 2 "start ($start) must be below end ($end)"
  [[ $start == "-" ]] || start=$((10#$start))
  end=$((10#$end))

  local battery
  battery=$(find_battery) || fail 3 "no battery with a charge limit found"

  local start_file=$battery/charge_control_start_threshold
  local end_file=$battery/charge_control_end_threshold
  if [[ $start == "-" || ! -e $start_file ]]; then
    write_value "$end_file" "$end"
    return 0
  fi

  # Drivers reject a start at or above the end, so write in the order that
  # never passes through such a pair.
  local current_end
  current_end=$(read_value "$end_file")
  if [[ $current_end =~ ^[0-9]+$ ]] && (( start >= current_end )); then
    write_value "$end_file" "$end"
    write_value "$start_file" "$start"
  else
    write_value "$start_file" "$start"
    write_value "$end_file" "$end"
  fi
}

cmd_set_behaviour() {
  (( $# == 1 )) || fail 2 "usage: bettery-hw set-behaviour auto|inhibit-charge|force-discharge"
  local mode=$1
  [[ $mode =~ ^(auto|inhibit-charge|force-discharge)$ ]] || fail 2 "invalid behaviour: $mode"

  local battery
  battery=$(find_battery) || fail 3 "no battery with a charge limit found"
  [[ -e $battery/charge_behaviour ]] || fail 3 "this battery has no charge_behaviour control"
  [[ " $(read_value "$battery/charge_behaviour" | tr -d '[]') " == *" $mode "* ]] || fail 3 "this battery does not support $mode"
  [[ $(current_behaviour "$battery") == "$mode" ]] && return 0
  [[ -w $battery/charge_behaviour ]] || fail 4 "no write access to $battery/charge_behaviour (run install.sh once)"
  printf '%s' "$mode" 2>/dev/null >"$battery/charge_behaviour" || fail 1 "the kernel refused $mode"
}

# Applies what it can and always answers with the status, plus the first
# error as "error" and "errorCode" lines, so the caller reads one stream.
cmd_apply() {
  (( $# == 3 )) || fail 2 "usage: bettery-hw apply START|- END|- MODE|-"
  local err="" code=0
  if [[ $2 != "-" ]]; then
    err=$( (cmd_set_thresholds "$1" "$2") 2>&1 >/dev/null ) || code=$?
  fi
  if (( code == 0 )) && [[ $3 != "-" ]]; then
    err=$( (cmd_set_behaviour "$3") 2>&1 >/dev/null ) || code=$?
  fi
  cmd_status
  if (( code != 0 )); then
    printf 'errorCode\t%s\n' "$code"
    printf 'error\t%s\n' "${err//$'\n'/ }"
  fi
}

case "${1:-}" in
  apply) shift; cmd_apply "$@" ;;
  status) shift; cmd_status "$@" ;;
  set-thresholds) shift; cmd_set_thresholds "$@" ;;
  set-behaviour) shift; cmd_set_behaviour "$@" ;;
  *) fail 2 "usage: bettery-hw status | apply START END MODE | set-thresholds START|- END | set-behaviour MODE" ;;
esac
